# tau-cli sandbox image — the cage's walls around the tau terminal.
# cage×tau hybrid (2026-08-19): same 8-layer security model as the claude
# image, but the agent inside is tau (provider-neutral, append-only JSONL
# sessions) instead of the Claude Code CLI.
#
# Base is python-slim (tau is Python), not node — one less runtime in the cage.
FROM python:3.12-slim

LABEL org.opencontainers.image.title="cage-tau-cli"
LABEL managed-by="claude-cage"

# tau is on PyPI as tau-ai.
RUN pip install --no-cache-dir tau-ai

# Non-root user (matches the claude image's cageuser posture).
RUN useradd -m -s /bin/bash cageuser
USER cageuser
WORKDIR /workspace

# tau's state lives at ~/.tau (sessions/, credentials.json). The cage mounts a
# persistent named volume here so sessions survive the ephemeral container.
VOLUME ["/workspace", "/home/cageuser/.tau"]

# tini as PID 1 for signal reaping (same as the claude image).
USER root
RUN apt-get update && apt-get install -y --no-install-recommends tini \
 && rm -rf /var/lib/apt/lists/*
USER cageuser

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD tau --version || exit 1

ENTRYPOINT ["tini", "--"]
CMD ["tau"]
